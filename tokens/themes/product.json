{
  "$comment": "Product UI (core.skylimit.ai, and the client portal next): light-first, sky blue on paper, with a dark mode under [data-theme=dark]. Only the identity roles live here; an app's own semantic colours (money, charts, tags) stay in the app.",
  "file": "theme-product.css",
  "blocks": [
    {
      "selector": ":root",
      "vars": {
        "--bg": "{color.paper.50}",
        "--surface": "{color.paper.0}",
        "--fg": "{color.ink.900}",
        "--fg-muted": "{color.slate.600}",
        "--sky": "{color.sky.500}",
        "--sky-strong": "{color.sky.600}",
        "--ring": "{color.sky.500}"
      }
    },
    {
      "selector": "[data-theme=\"dark\"]",
      "vars": {
        "--bg": "{color.ink.950}",
        "--surface": "{color.ink.850}",
        "--fg": "{color.slate.200}",
        "--fg-muted": "{color.slate.300}",
        "--sky": "{color.sky.400}",
        "--sky-strong": "{color.sky.300}",
        "--ring": "{color.sky.400}"
      }
    }
  ],
  "contrast": [
    { "block": 0, "fg": "--fg", "bg": "--bg", "min": 4.5 },
    { "block": 0, "fg": "--fg-muted", "bg": "--surface", "min": 4.5 },
    { "block": 0, "fg": "--sky", "bg": "--surface", "min": 3 },
    { "block": 1, "fg": "--fg", "bg": "--bg", "min": 4.5 },
    { "block": 1, "fg": "--fg-muted", "bg": "--surface", "min": 4.5 },
    { "block": 1, "fg": "--sky", "bg": "--surface", "min": 3 }
  ]
}
